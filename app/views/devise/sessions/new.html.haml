.max-w-md.mx-auto.mt-8.p-6.bg-white.rounded-lg.shadow-md
  %h2.text-2xl.font-bold.mb-6.text-center ログイン

  / アラートメッセージ
  - if alert.present?
    .bg-yellow-50.border.border-yellow-200.rounded.p-4.mb-4
      %p.text-sm.text-yellow-800
        ⚠️
        = alert

  / セキュリティ警告メッセージ
  .bg-blue-50.border.border-blue-200.rounded.p-4.mb-4
    %p.text-sm.text-blue-800
      🔒 
      %strong セキュリティ強化：
      ログイン失敗が5回に達すると、アカウントが30分間ロックされます。
    %p.text-sm.text-blue-700.mt-1
      ロック時にはメールで通知されます。
  
  / デバッグ情報（開発環境のみ）
  - if Rails.env.development?
    .bg-slate-100.border.border-slate-300.rounded.p-4.mb-4
      %p.text-xs.text-slate-700.font-mono
        🔧 開発環境デバッグ情報
      %p.text-xs.text-slate-600.font-mono.mt-1
        テストアカウント: demo@example.com / password123

  = form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4", data: { turbo: false } }) do |f|
    .field
      = f.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-1"
      = f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"

    .field
      = f.label :password, "パスワード", class: "block text-sm font-medium text-gray-700 mb-1"
      = f.password_field :password, autocomplete: "current-password", class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"

    - if devise_mapping.rememberable?
      .field.flex.items-center
        = f.check_box :remember_me, checked: true, class: "h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
        = f.label :remember_me, "ログイン状態を保持（6時間）", class: "ml-2 block text-sm text-gray-700"

    .actions
      = f.submit "ログイン", class: "w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500"

  .mt-4.text-center
    = render "devise/shared/links"
