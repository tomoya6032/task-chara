/ 支援報告書一覧ページ
= content_for :page_title, "支援報告書"

.px-4.sm:px-6.lg:px-8.py-8.pb-24.lg:pb-8
  / ヘッダー
  .mb-8
    %h1.text-3xl.font-bold.text-slate-900.dark:text-white
      📋 支援報告書
    %p.text-slate-600.dark:text-slate-400.mt-2
      AI生成による月次支援報告書の管理

  / 統計カード
  .grid.grid-cols-1.md:grid-cols-3.gap-6.mb-8
    .bg-white.dark:bg-slate-800.overflow-hidden.shadow-xl.rounded-2xl.border.border-slate-200.dark:border-slate-700
      .px-6.py-4
        .flex.items-center
          .flex-shrink-0
            %span.text-2xl 📋
          .ml-3
            %p.text-sm.font-medium.text-slate-500.dark:text-slate-400 総報告書数
            %p.text-2xl.font-semibold.text-slate-900.dark:text-white
              = @total_count
              %span.text-sm.font-normal.text-slate-500 件

    .bg-white.dark:bg-slate-800.overflow-hidden.shadow-xl.rounded-2xl.border.border-slate-200.dark:border-slate-700
      .px-6.py-4
        .flex.items-center
          .flex-shrink-0
            %span.text-2xl 📝
          .ml-3
            %p.text-sm.font-medium.text-slate-500.dark:text-slate-400 ドラフト
            %p.text-2xl.font-semibold.text-slate-900.dark:text-white
              = @draft_count
              %span.text-sm.font-normal.text-slate-500 件

    .bg-white.dark:bg-slate-800.overflow-hidden.shadow-xl.rounded-2xl.border.border-slate-200.dark:border-slate-700
      .px-6.py-4
        .flex.items-center
          .flex-shrink-0
            %span.text-2xl ✅
          .ml-3
            %p.text-sm.font-medium.text-slate-500.dark:text-slate-400 完成済み
            %p.text-2xl.font-semibold.text-slate-900.dark:text-white
              = @completed_count
              %span.text-sm.font-normal.text-slate-500 件

  / 新規作成ボタン
  .flex.justify-between.items-center.mb-6
    %div
    = link_to new_support_report_path, 
        class: "inline-flex items-center px-6 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors shadow-sm" do
      ➕ 新しい報告書

  / 検索・ソートフォーム
  .bg-white.dark:bg-slate-800.shadow-xl.rounded-2xl.border.border-slate-200.dark:border-slate-700.p-6.mb-6
    = form_with url: support_reports_path, method: :get, class: "space-y-4", data: { controller: "search-form" } do |f|
      .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-4.gap-4
        / キーワード検索
        .space-y-2
          = f.label :keyword, "キーワード", class: "block text-sm font-medium text-slate-700 dark:text-slate-300"
          = f.text_field :keyword, 
              value: params[:keyword],
              placeholder: "タイトルまたは内容",
              class: "block w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-slate-700 dark:text-white"
        
        / ステータス検索
        .space-y-2
          = f.label :status, "ステータス", class: "block text-sm font-medium text-slate-700 dark:text-slate-300"
          = f.select :status, options_for_select([["すべて", ""], ["📝 下書き", "draft"], ["⏳ 生成中", "generating"], ["✅ 完成", "completed"], ["❌ エラー", "error"]], params[:status]), {}, { class: "block w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-slate-700 dark:text-white" }
        
        / 期間検索（開始日）
        .space-y-2
          = f.label :period_start, "期間開始日", class: "block text-sm font-medium text-slate-700 dark:text-slate-300"
          = f.date_field :period_start,
              value: params[:period_start],
              class: "block w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-slate-700 dark:text-white"
        
        / 期間検索（終了日）
        .space-y-2
          = f.label :period_end, "期間終了日", class: "block text-sm font-medium text-slate-700 dark:text-slate-300"
          = f.date_field :period_end,
              value: params[:period_end],
              class: "block w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-slate-700 dark:text-white"
      
      / ソート機能
      .grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-3.gap-4.mt-4
        .space-y-2
          = f.label :sort, "並び替え", class: "block text-sm font-medium text-slate-700 dark:text-slate-300"
          = f.select :sort, options_for_select([["作成日", "created_at"], ["更新日", "updated_at"], ["期間開始日", "period_start"], ["期間終了日", "period_end"]], params[:sort] || "created_at"), {}, { class: "block w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-slate-700 dark:text-white" }
        
        .space-y-2
          = f.label :direction, "順序", class: "block text-sm font-medium text-slate-700 dark:text-slate-300"
          = f.select :direction, options_for_select([["新しい順", "desc"], ["古い順", "asc"]], params[:direction] || "desc"), {}, { class: "block w-full px-4 py-2 border border-slate-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 dark:bg-slate-700 dark:text-white" }
        
        / 検索ボタン
        .flex.items-end.space-x-2
          = f.submit "🔍 検索", class: "px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors"
          = link_to "クリア", support_reports_path, class: "px-6 py-2 bg-slate-200 hover:bg-slate-300 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 font-medium rounded-lg transition-colors"
  
  / 検索条件の表示
  - if search_active?
    .bg-blue-50.dark:bg-slate-700.border.border-blue-200.dark:border-slate-600.rounded-lg.p-4.mb-6
      .flex.items-center.justify-between
        .flex.items-center.space-x-3
          %span.text-blue-600.dark:text-blue-400.font-medium 🔍 検索中:
          .flex.flex-wrap.gap-2
            - if params[:keyword].present?
              %span.inline-flex.items-center.px-3.py-1.rounded-full.text-sm.bg-blue-100.dark:bg-slate-600.text-blue-800.dark:text-blue-200
                キーワード: #{params[:keyword]}
            - if params[:status].present?
              %span.inline-flex.items-center.px-3.py-1.rounded-full.text-sm.bg-blue-100.dark:bg-slate-600.text-blue-800.dark:text-blue-200
                ステータス: #{params[:status]}
            - if params[:period_start].present?
              %span.inline-flex.items-center.px-3.py-1.rounded-full.text-sm.bg-blue-100.dark:bg-slate-600.text-blue-800.dark:text-blue-200
                開始日: #{params[:period_start]}
            - if params[:period_end].present?
              %span.inline-flex.items-center.px-3.py-1.rounded-full.text-sm.bg-blue-100.dark:bg-slate-600.text-blue-800.dark:text-blue-200
                終了日: #{params[:period_end]}
        = link_to "✕ 検索をクリア", support_reports_path, class: "text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300 text-sm font-medium"

  / 支援報告書一覧
  .bg-white.dark:bg-slate-800.shadow-xl.rounded-2xl.border.border-slate-200.dark:border-slate-700.overflow-hidden
    - if @support_reports.any?
      .divide-y.divide-slate-200.dark:divide-slate-700
        - @support_reports.each do |report|
          = link_to support_report_path(report, search_params_for_link),
              class: "block hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors" do
            .px-6.py-4
              .flex.items-start.justify-between
                .flex-1.min-w-0
                  .flex.items-center.space-x-3.mb-2
                    %span.inline-flex.items-center.px-2.py-1.rounded-full.text-xs.font-medium{
                      class: case report.status
                        when 'draft' then 'bg-gray-100 text-gray-800'
                        when 'generating' then 'bg-yellow-100 text-yellow-800'
                        when 'completed' then 'bg-green-100 text-green-800'
                        when 'error' then 'bg-red-100 text-red-800'
                      end
                    }
                      - case report.status
                        - when 'draft'
                          📝 下書き
                        - when 'generating'
                          ⏳ 生成中
                        - when 'completed'
                          ✅ 完成
                        - when 'error'
                          ❌ エラー

                  %h3.text-lg.font-semibold.text-slate-900.dark:text-white.truncate
                    = strip_tags(report.title)
                  .flex.items-center.space-x-4.text-sm.text-slate-500.dark:text-slate-400
                    %span
                      📅 #{report.period_display}
                    %span
                      🕒 #{report.created_at.strftime('%Y年%m月%d日')} 作成
                    - if report.generated_at
                      %span
                        ✨ #{report.generated_at.strftime('%m/%d %H:%M')} 生成

                  - if report.content.present?
                    %p.text-sm.text-slate-600.dark:text-slate-300.mt-2.line-clamp-2
                      = truncate(strip_tags(report.content), length: 120)

      / ページネーション
      - if @support_reports.respond_to?(:current_page)
        .px-6.py-4.bg-slate-50.dark:bg-slate-900.border-t.border-slate-200.dark:border-slate-700
          .flex.justify-center
            = paginate @support_reports, params: { keyword: params[:keyword], status: params[:status], period_start: params[:period_start], period_end: params[:period_end], sort: params[:sort], direction: params[:direction] }
    
    - else
      / 空の状態
      .text-center.py-12
        .mx-auto.h-24.w-24.text-6xl.mb-4
          📋
        %h3.text-lg.font-medium.text-slate-900.dark:text-white.mb-2
          支援報告書がありません
        %p.text-slate-500.dark:text-slate-400.mb-6
          AIが日報データから自動で支援報告書を生成します
        = link_to new_support_report_path, 
            class: "inline-flex items-center px-6 py-3 border border-transparent text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do
          ➕ 最初の報告書を作成