#!/usr/bin/env ruby
# bin/test_ai_secretary_line_send
# AI秘書のタスクLINE送信機能をテストするスクリプト

require_relative '../config/environment'

puts "=" * 70
puts "🧪 AI秘書タスクLINE送信機能 統合テスト"
puts "=" * 70
puts ""

# 1. 環境確認
puts "📍 環境確認"
puts "-" * 70
puts "  Ruby: #{RUBY_VERSION}"
puts "  Rails: #{Rails.version}"
puts "  Environment: #{Rails.env}"
puts "  Time Zone: #{Time.zone.name}"
puts "  Current Time: #{Time.current}"
puts ""

# 2. Character確認
character = Character.first
if character.nil?
  puts "❌ Character not found"
  exit 1
end

puts "👤 Character情報"
puts "-" * 70
puts "  ID: #{character.id}"
puts "  Name: #{character.name}"
puts "  User ID: #{character.user_id}"
puts "  LINE User ID: #{character.user&.line_user_id.present? ? '設定済み' : '未設定'}"
puts ""

# 3. テストタスク作成
puts "📝 テストタスク作成"
puts "-" * 70

# 既存のテストタスクを削除
old_test_tasks = character.tasks.where("title LIKE ?", "【テスト】%")
if old_test_tasks.any?
  old_test_tasks.destroy_all
  puts "  🗑️  既存のテストタスク#{old_test_tasks.count}件を削除"
end

# 新しいテストタスクを作成
test_task = character.tasks.create!(
  title: "【テスト】今日15時のミーティング",
  category: "meeting",
  due_date: Time.current.change(hour: 15, min: 0),
  dislike_level: 5,
  is_draft: false
)

puts "  ✅ テストタスク作成完了"
puts "     ID: #{test_task.id}"
puts "     Title: #{test_task.title}"
puts "     Due Date: #{test_task.due_date}"
puts "     Category: #{test_task.category_display}"
puts ""

# 4. タスク抽出テスト
puts "🔍 タスク抽出テスト"
puts "-" * 70

today_start = Time.current.beginning_of_day
today_end = Time.current.end_of_day
today_tasks = character.tasks.pending.visible.published.where(due_date: today_start..today_end)

puts "  検索範囲: #{today_start} 〜 #{today_end}"
puts "  抽出結果: #{today_tasks.count}件"
today_tasks.each_with_index do |task, idx|
  puts "    #{idx + 1}. #{task.title} (#{task.due_date})"
end
puts ""

# 5. TaskLineNotifierService テスト
puts "📤 TaskLineNotifierService テスト"
puts "-" * 70

# LINE User IDを一時的に設定（テスト用）
original_line_user_id = character.user.line_user_id
if original_line_user_id.blank?
  puts "  ⚠️  LINE User IDが未設定のため、一時的なIDを設定します"
  character.user.update_column(:line_user_id, "U_TEST_#{SecureRandom.hex(16)}")
  puts "  ✅ テスト用LINE User ID設定完了"
end

service = TaskLineNotifierService.new(
  character: character,
  filters: { time_frame: "today", limit: 10, filter_type: "uncompleted" }
)

# タスク抽出のみテスト（実際のLINE送信はしない）
extracted_tasks = service.send(:extract_tasks)
puts "  抽出タスク数: #{extracted_tasks.count}件"

# LINEメッセージ構築テスト
if extracted_tasks.any?
  message = service.send(:build_line_message, extracted_tasks)
  puts ""
  puts "  📱 構築されるLINEメッセージ:"
  puts "  " + "-" * 66
  message.lines.each { |line| puts "  #{line}" }
  puts "  " + "-" * 66
end

# LINE User IDを元に戻す
if original_line_user_id.blank?
  character.user.update_column(:line_user_id, nil)
  puts ""
  puts "  🔧 LINE User IDを元に戻しました"
end

puts ""

# 6. Tool Calling統合テスト
puts "🔧 Tool Calling統合テスト"
puts "-" * 70

controller = AiSecretaryController.new
controller.instance_variable_set(:@character, character)

# ツール定義確認
tools = controller.send(:define_tools)
puts "  定義されているツール数: #{tools.count}"
tools.each_with_index do |tool, idx|
  puts "    #{idx + 1}. #{tool.dig(:function, :name)}"
  puts "       Description: #{tool.dig(:function, :description).truncate(80)}"
end
puts ""

# 模擬的なツール呼び出し
mock_tool_calls = [
  {
    "id" => "call_test_#{SecureRandom.hex(8)}",
    "type" => "function",
    "function" => {
      "name" => "send_tasks_to_line",
      "arguments" => JSON.generate({
        "time_frame" => "today",
        "limit" => 10,
        "filter_type" => "uncompleted"
      })
    }
  }
]

puts "  📤 模擬ツール呼び出し実行中..."
puts ""

results = controller.send(:execute_tools, mock_tool_calls)

puts "  📊 実行結果:"
results.each_with_index do |result, idx|
  content = JSON.parse(result[:content])
  puts "    結果 #{idx + 1}:"
  puts "      Tool Call ID: #{result[:tool_call_id]}"
  puts "      Success: #{content['success']}"
  puts "      Message: #{content['message']}"
  puts "      Tasks Count: #{content['tasks_count']}"
end

puts ""

# 7. ログ確認
puts "📄 最新のログ確認（最後の30行）"
puts "-" * 70

log_file = Rails.root.join("log", "#{Rails.env}.log")
if File.exist?(log_file)
  log_lines = `tail -n 30 #{log_file} | grep "TaskLineNotifier\\|AI Secretary\\|Tool Calling"`.lines
  if log_lines.any?
    log_lines.each { |line| puts "  #{line}" }
  else
    puts "  ℹ️  該当するログエントリが見つかりませんでした"
  end
else
  puts "  ⚠️  ログファイルが見つかりません: #{log_file}"
end

puts ""

# 8. まとめ
puts "=" * 70
puts "✅ テスト完了"
puts "=" * 70
puts ""
puts "📋 次のステップ:"
puts "  1. AI秘書チャット画面を開く"
puts "  2. 「今日のタスクをLINEに送って」と入力"
puts "  3. ログを確認:"
puts "     - [AI Secretary] ✅ Tool calls detected が出力されるか"
puts "     - [TaskLineNotifier] 📊 Tasks extracted が出力されるか"
puts "     - AI秘書が適切に応答するか"
puts ""
puts "  ログ確認コマンド:"
puts "    tail -f log/#{Rails.env}.log | grep \"TaskLineNotifier\\|AI Secretary\""
puts ""

# テストタスクを削除するか確認
print "テストタスクを削除しますか？ [y/N]: "
answer = STDIN.gets.chomp.downcase
if answer == 'y'
  test_task.destroy
  puts "  🗑️  テストタスクを削除しました"
else
  puts "  ℹ️  テストタスクを保持します（ID: #{test_task.id}）"
end

puts ""
